# For new installs, copy this file to .env and fill in your real values.
# Upgrades: preserve the existing .env; see docs/DEPLOYMENT.md.
# Single quotes keep special characters such as $ and # literal.
WEBHOOK_TOKEN='CHANGE-ME-TO-A-LONG-RANDOM-TOKEN'

# true: return meaningful JSON errors; false: empty error responses with private logs.
DEBUG_MODE=false

# Existing undated logs are preserved when switching to default daily rotation.
# Private structured logging. Relative directories resolve from the project root.
# Paths inside public/ are rejected. Daily/monthly rotation uses APP_TIMEZONE.
LOG_ENABLED=true
LOG_LEVEL=info
LOG_DIRECTORY='logs'
LOG_FILENAME='webhook.log'
LOG_FORMAT=json
LOG_ROTATION=daily
# Retained files including current; 0 = unlimited. Ignored for rotation=none.
LOG_MAX_FILES=30
# Debug mode suppresses logs unless explicitly opted in.
LOG_IN_DEBUG=false

APP_TIMEZONE='Europe/Rome'
# Enable each destination independently.
# All three false: validate and acknowledge requests without saving or forwarding.
STORE_TO_FOLDER=true
FORWARD_TO_MAIL=true
SAVE_TO_TODOIST=false

# Required only when STORE_TO_FOLDER=true.
STORAGE_DIRECTORY='recordings'

# SMTP and MAIL settings are required only when FORWARD_TO_MAIL=true.
# smtp + 587 = required STARTTLS; smtps + 465 = implicit TLS.
SMTP_SCHEME='smtp'
SMTP_HOST='smtp.example.com'
SMTP_PORT='587'
SMTP_USERNAME='your-smtp-username'
SMTP_PASSWORD='your-smtp-password'

MAIL_FROM='webhook@example.com'
MAIL_TO='you@example.com'
MAIL_SUBJECT_PREFIX='Pebble recording'

# Required only when SAVE_TO_TODOIST=true. Use a personal API token (not OAuth).
TODOIST_API_TOKEN='your-todoist-api-token'
TODOIST_PARENT_PROJECT='your-todoist-parent-project-id'

# Optional operator failure alerts, independent of FORWARD_TO_MAIL and LOG_ENABLED.
# Credentials below are required only when enabled (and allowed in debug mode).
FAILURE_EMAIL_ENABLED=false
FAILURE_EMAIL_LEVEL=error
FAILURE_EMAIL_IN_DEBUG=false
FAILURE_EMAIL_FROM='hub-alerts@example.com'
# One or more recipients separated by commas.
FAILURE_EMAIL_TO='operator@example.com'
FAILURE_EMAIL_SUBJECT_PREFIX='Pebble Hub failure'
FAILURE_EMAIL_COOLDOWN_SECONDS=300
FAILURE_EMAIL_STATE_DIRECTORY='var/alerts'
# Timeout for SMTP socket connect/read operations, in seconds.
FAILURE_EMAIL_TIMEOUT_SECONDS=10
# Use a separate provider so note-email outages can still be reported.
# smtp requires STARTTLS; smtps uses implicit TLS. Certificates are verified.
FAILURE_EMAIL_SMTP_SCHEME='smtp'
FAILURE_EMAIL_SMTP_HOST='smtp.alert-provider.example'
FAILURE_EMAIL_SMTP_PORT=587
FAILURE_EMAIL_SMTP_USERNAME='alert-smtp-username'
FAILURE_EMAIL_SMTP_PASSWORD='alert-smtp-password'

# Optional local example package. Install and register before enabling; see docs/EXTENSIONS.md.
# Installing a package alone does not register a destination.
EXAMPLE_RECEIPT_ENABLED=false
EXAMPLE_RECEIPT_DIRECTORY='var/example-receipts'
# Demonstration modes only: success, partial, failure. Leave success for normal use.
EXAMPLE_RECEIPT_MODE=success
