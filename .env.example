# Copy this file to .env and fill in your real values.
# Single quotes keep special characters such as $ and # literal.
WEBHOOK_TOKEN='CHANGE-ME-TO-A-LONG-RANDOM-TOKEN'

# true: return meaningful JSON errors; false: empty error responses with private logs.
DEBUG_MODE=false

# Optional private log location; relative directories resolve from the project root.
# Paths inside public/ are rejected. Rotation settings arrive in a later phase.
LOG_DIRECTORY='logs'
LOG_FILENAME='webhook.log'

APP_TIMEZONE='Europe/Rome'
# Enable each destination independently.
# All three false: validate and acknowledge requests without saving or forwarding.
STORE_TO_FOLDER=true
FORWARD_TO_MAIL=true
SAVE_TO_TODOIST=false

# Required only when STORE_TO_FOLDER=true.
STORAGE_DIRECTORY='recordings'

# SMTP and MAIL settings are required only when FORWARD_TO_MAIL=true.
# smtp + 587 = required STARTTLS; smtps + 465 = implicit TLS.
SMTP_SCHEME='smtp'
SMTP_HOST='smtp.example.com'
SMTP_PORT='587'
SMTP_USERNAME='your-smtp-username'
SMTP_PASSWORD='your-smtp-password'

MAIL_FROM='webhook@example.com'
MAIL_TO='you@example.com'
MAIL_SUBJECT_PREFIX='Pebble recording'

# Required only when SAVE_TO_TODOIST=true. Use a personal API token (not OAuth).
TODOIST_API_TOKEN='your-todoist-api-token'
TODOIST_PARENT_PROJECT='your-todoist-parent-project-id'
